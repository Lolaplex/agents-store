# Radicale serving the agents-store canonical layer over CalDAV.
# POC config: localhost only, auth type=none accepts ANY credentials.
# Production auth is out of scope (see docs/acceptance-matrix.md).
#
# The plugin's db path comes from env AGENTS_STORE_DB, else
# <storage.filesystem_folder>/agents-store.sqlite, else ./agents-store.sqlite.
#
#   PowerShell:
#     $env:AGENTS_STORE_DB = "$PWD\scratch\demo.sqlite"
#     .venv\Scripts\python -m radicale --config examples/radicale.config
#
# Then point a client at http://127.0.0.1:5232/<username>/calendar/
# (the principal is the username you logged in with — any name works).

[server]
hosts = 127.0.0.1:5232

[auth]
type = none

[rights]
type = owner_only

[storage]
type = radicale_agents_store
